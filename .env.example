# Wallet seed phrase (BIP-39 mnemonic) used by the CLI deploy/inspect scripts.
# NEVER commit your real .env. Copy this file to .env and fill in your mnemonic.
MIDNIGHT_PREPROD_MNEMONIC="your twelve or twenty-four word mnemonic here"

# Blockfrost project id for the CLI's Preprod indexer and node RPC.
# Midnight retired indexer.preprod.midnight.network and rpc.preprod.midnight.network
# on 9 Oct 2026; Preprod now goes through Blockfrost and rejects requests with no
# token (HTTP 403). Create a project for the Midnight Preprod network at
# https://blockfrost.io — the id starts with "nightpreprod".
# Preview and the local devnet do not use this. Never commit the real value.
BLOCKFROST_PROJECT_ID=nightpreprod_your_project_id_here

# Network is selected via MIDNIGHT_NETWORK when running scripts, e.g.:
#   MIDNIGHT_NETWORK=preview  yarn deploy:preview
#   MIDNIGHT_NETWORK=preprod  yarn deploy:preprod
