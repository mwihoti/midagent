# Wallet seed phrase (BIP-39 mnemonic) used by the CLI deploy/inspect scripts.
# NEVER commit your real .env. Copy this file to .env and fill in your mnemonic.
MIDNIGHT_PREPROD_MNEMONIC="your twelve or twenty-four word mnemonic here"

# Network is selected via MIDNIGHT_NETWORK when running scripts, e.g.:
#   MIDNIGHT_NETWORK=preview  yarn deploy:preview
#   MIDNIGHT_NETWORK=preprod  yarn deploy:preprod
