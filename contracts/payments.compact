pragma language_version >= 0.23;

import CompactStandardLibrary;

export enum PaymentType { PER_CALL, SUBSCRIPTION, OUTCOME_BASED }

// Public ledger. Both maps hold *commitments* to private payment details —
// amounts, payer and payee stay off-chain. An observer learns that an escrow or
// subscription exists, never its terms.
export ledger escrows: Map<Bytes<32>, Bytes<32>>;
export ledger subscriptions: Map<Bytes<32>, Bytes<32>>;

witness escrowDetails(): Bytes<32>;
witness subscriptionDetails(): Bytes<32>;

export circuit createEscrow(escrowId: Bytes<32>): [] {
  const details = escrowDetails();
  const detailsCommitment = persistentHash<Bytes<32>>(details);
  escrows.insert(disclose(escrowId), disclose(detailsCommitment));
}

export circuit releaseEscrow(escrowId: Bytes<32>): [] {
  assert(escrows.member(disclose(escrowId)), "escrow not found");
}

export circuit cancelEscrow(escrowId: Bytes<32>): [] {
  assert(escrows.member(disclose(escrowId)), "escrow not found");
}

export circuit createSubscription(subId: Bytes<32>): [] {
  const details = subscriptionDetails();
  const detailsCommitment = persistentHash<Bytes<32>>(details);
  subscriptions.insert(disclose(subId), disclose(detailsCommitment));
}

export circuit revokeSubscription(subId: Bytes<32>): [] {
  assert(subscriptions.member(disclose(subId)), "subscription not found");
}
